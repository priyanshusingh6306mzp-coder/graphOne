# FrontierAtlas / GraphOne Ingestion Pipeline Environment Configuration

# Custom User-Agent (identifying bot + contact email per crawling policy)
USER_AGENT=GraphOneTrialBot/0.1 (+mailto:ops@frontieratlas.com)

# GitHub Personal Access Token (for fetching research paper repo stars via REST API)
GITHUB_TOKEN=your_github_token_here

# LLM Provider Keys (at least one key required for llm-pricing and news extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LLM Model Configuration (defaults to active models; overridable via env)
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
DEEPSEEK_MODEL=deepseek-chat

# Google Sheets Export Configuration (optional; CSV fallback exported automatically if omitted)
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
SHEET_ID=your_google_sheet_id_here
